lang_name=日本語
yes_words=y yes はい
no_words=n no いいえ
hint_yes=[Y/n]
hint_no=[y/N]
pause=[Enter] を押して続行 ...
lang_keep=選択 [Enter = %s]:

dry_nothing=ドライラン：何も書き込まれていません。
file_uptodate=%s はすでに最新です。
changes_to=%s への変更：
old=変更前
new=変更後
file_written=%s を書き込みました。
install_manually=不明なディストリビューションです – 手動でインストールしてください：%s
atomic_layer=アトミックシステム（Silverblue/Kinoite/Bazzite …）：パッケージは rpm-ostree で重ねてインストールされます。再起動が必要です。
not_installed='%s' はインストールされていません。
install_now=パッケージ '%s' を今すぐインストールしますか？
cancel=キャンセル
choice=選択：
unknown=不明

t_diag=システム情報 / 診断
